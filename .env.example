APP_NAME=Laravel
APP_ENV=local
NODE_ENV=development
VITE_BUILD=true
VITE_USER_NODE_ENV=production
APP_DEBUG=true
APP_KEY=base64:YourBase64AppKeyHere
VITE_APP_URL=https://your-app-url.com
AWS_URL=https://your-bucket-url.com
APP_URL=https://your-app-api-url.com
AWS_USE_PATH_STYLE_ENDPOINT=false

LOG_CHANNEL=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

DATABSE_URL=127.0.0.1:8000

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_DEFAULT_REGION=eu-west-2
# AWS_BUCKET_NAME=your-bucket-name
VITE_AWS_BUCKET=your-bucket-name

DARK_SKY_KEY=your_dark_sky_api_key

OPENAI_SECRET=your_openai_key
OPENAI_ORGANISATION=your_openai_org_id

BROADCAST_DRIVER=pusher
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_key
PUSHER_APP_SECRET=your_pusher_secret
PUSHER_APP_CLUSTER=your_cluster

APP_SECRET=your_app_secret

###> doctrine/doctrine-bundle ###
# DATABASE_URL format:
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###